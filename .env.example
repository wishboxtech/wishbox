# Local development only. `make setup` generates unique signing keys.
STAGE=local
SITE_NAME=wishbox
SITE_ID=1
ALLOWED_HOSTS=localhost,127.0.0.1,back,testserver
DEFAULT_DOMAIN=localhost
DEFAULT_DATABASE_NAME=wishbox
DEFAULT_DATABASE_USER=wishbox
DEFAULT_DATABASE_PASSWORD=wishbox-local
DEFAULT_DATABASE_HOST=127.0.0.1
DEFAULT_DATABASE_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
LANGUAGE_CODE=en
MEDIA_ROOT=media
MEDIA_URL=/media/
STATIC_ROOT=static
STATIC_URL=/static/
# Optional Arvan S3 media storage. Use the endpoint/region shown in your bucket panel.
USE_S3=False
S3_BUCKET_NAME=wishy
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
S3_QUERYSTRING_AUTH=True
S3_QUERYSTRING_EXPIRE=3600
S3_CUSTOM_DOMAIN=
S3_LOCATION=
TEMPLATE_DIR=templates
DEBUG=True
ENABLE_SWAGGER=True
UNDER_DEVELOPMENT=True
OTP_CODE_LENGTH=6
OTP_TTL=120
ACCESS_TTL=3600
REFRESH_TTL=604800
JWT_SECRET=generate-on-setup
SECRET_KEY=generate-on-setup
NATS_CLUSTER_ID=wishbox-local
NATS_URL=nats://127.0.0.1:4222
OTP_HOUR=30/h
OTP_DAY=100/d
LIKE_HOUR=10/h
LIKE_DAY=100/d
COMMENT_HOUR=10/h
COMMENT_DAY=100/d
# Change host ports when another project uses the defaults.
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
